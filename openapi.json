  "info": {
    "title": "Studviro API",
    "description": "Studviro backend HTTP API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Authentication and session lifecycle"
    },
    {
      "name": "users",
      "description": "User accounts"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Ada Lovelace"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "displayName",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "description": "The interface language this account is served in. It is part of the user\nrather than a client-side preference so it follows them across devices —\nthe browser cookie is a cache of this value, not the source of truth.",
            "enum": [
              "en",
              "uk"
            ]
          },
          "role": {
            "enum": [
              "user",
              "admin"
            ],
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "locale",
          "role",
          "createdAt"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access-token lifetime in seconds.",
            "example": 900
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "tokenType",
          "user"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "description": "A single message, or one entry per failed validation constraint.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": [
              "email must be an email"
            ]
          },
          "path": {
            "type": "string",
            "example": "/api/v1/users"
          },
          "requestId": {
            "type": "string",
            "description": "Echoed back in the `x-request-id` header — quote it in bug reports.",
            "example": "3f6c1e2a-..."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "description": "Deliberately looser than `CreateUserDto.password`: tightening it here would\nreject a legitimate credential set before the policy changed, and would let\na caller probe the current policy without an account.",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Ada Lovelace"
          },
          "locale": {
            "enum": [
              "en",
              "uk"
            ],
            "type": "string"
          }
        }
      },
      "PageMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "pageCount": {
            "type": "number"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "pageCount",
          "hasNextPage",
          "hasPreviousPage"
        ]
      },
      "UserResponseDtoPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMetaDto"
          }
        },
        "required": [
          "items",
          "meta"
        ]
      },
      "SortOrder": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ]
      },
      "RoleAssignmentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "enum": [
              "student",
              "teacher",
              "teaching_assistant",
              "course_coordinator",
              "program_coordinator",
              "registrar",
              "org_unit_manager",
              "institution_admin"
            ],
            "type": "string"
          },
          "scopeType": {
            "enum": [
              "institution",
              "org_unit",
              "program",
              "course_offering"
            ],
            "type": "string"
          },
          "scopeId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "validFrom": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "institutionId",
          "userId",
          "role",
          "scopeType"
        ]
      },
      "GrantRoleDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "enum": [
              "student",
              "teacher",
              "teaching_assistant",
              "course_coordinator",
              "program_coordinator",
              "registrar",
              "org_unit_manager",
              "institution_admin"
            ],
            "type": "string"
          },
          "scopeType": {
            "enum": [
              "institution",
              "org_unit",
              "program",
              "course_offering"
            ],
            "type": "string"
          },
          "scopeId": {
            "type": "string",
            "format": "uuid",
            "description": "The org unit, program or course offering the role applies to."
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "role",
          "scopeType"
        ]
      },
      "ExternalIdentityResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceSystem": {
            "enum": [
              "platform",
              "sis",
              "lms"
            ],
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "externalUsername": {
            "type": "string",
            "nullable": true
          },
          "lastAuthenticatedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "institutionId",
          "sourceSystem",
          "issuer"
        ]
      }
    }
  }
}
