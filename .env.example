# Copy to `.env` and adjust. Every variable here is declared and validated in
# src/config/env.schema.ts — the app refuses to boot if one is missing or wrong.
#
# Some values that are convenient here are rejected outright when
# NODE_ENV=production (wildcard CORS, public Swagger, the placeholder JWT
# secrets). See `assertProductionHardening` in env.schema.ts.

NODE_ENV=development
# api | worker | all — `api` skips queue consumers, `worker` binds no port.
ROLE=all
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
API_PREFIX=api

LOG_LEVEL=debug

# Comma-separated origins in production. `*` is development-only: combined with
# credentialed requests it would let any site call the API as a signed-in user.
CORS_ORIGINS=*

# Comma-separated proxy IPs/CIDRs, or `loopback`. Never `true` — trusting every
# hop lets a client forge X-Forwarded-For and walk past the per-IP rate limit.
TRUSTED_PROXIES=loopback

BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
# Readiness reports unavailable for this long before shutdown begins, so the
# load balancer stops routing before providers are torn down.
SHUTDOWN_DRAIN_MS=5000

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgres://studviro:studviro@localhost:5432/studviro
# Optional read replica. Reads route here automatically once it is set.
# DATABASE_URL_REPLICA=
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# An unbounded query holds its pool slot indefinitely; these cap the damage.
DATABASE_STATEMENT_TIMEOUT_MS=20000
DATABASE_IDLE_TX_TIMEOUT_MS=30000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false
# REDIS_PASSWORD=

QUEUE_PREFIX=studviro
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=1000
QUEUE_UI_ENABLED=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Credential endpoints only. Deliberately far tighter than the global limit.
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
# Unauthenticated form submissions (e.g. the public demo request form).
PUBLIC_FORM_THROTTLE_TTL_MS=60000
PUBLIC_FORM_THROTTLE_LIMIT=60

CACHE_TTL_MS=30000
# How long a replayed Idempotency-Key returns the original response.
IDEMPOTENCY_TTL_MS=86400000

# Placeholders. Production requires two distinct secrets of >=32 chars, or a
# stolen access token could be replayed as a refresh token.
JWT_ACCESS_SECRET=dev-only-insecure-secret-do-not-use-in-production
JWT_REFRESH_SECRET=dev-only-insecure-secret-do-not-use-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Encrypts each authenticator-app secret at rest. Placeholder; production requires
# a unique secret of >=32 chars. Changing it disables every enrolled authenticator.
TWO_FACTOR_SECRET_KEY=dev-only-insecure-two-factor-key-do-not-use-in-prod
# The name an authenticator app shows next to the code.
TWO_FACTOR_ISSUER=StudViro

# Encrypts connector credentials at rest. Placeholder; production requires a
# unique secret of >=32 chars.

METRICS_ENABLED=true
# Required only when metrics are enabled in production; must be >=32 characters.
# METRICS_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# Off by default: it publishes the whole API surface and disables the Helmet CSP.
SWAGGER_ENABLED=true
# Locks the docs (UI, /docs/json, /docs/yaml) behind HTTP Basic auth. Optional
# locally; in production SWAGGER_ENABLED=true is refused unless both are set, so
# a deployed staging environment can serve docs without publishing them.
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=

# --- Object storage (S3-compatible) -----------------------------------------
# Defaults point at the MinIO in docker-compose, so `pnpm docker:up` is all a
# developer needs. For production set these to Cloudflare R2 or AWS S3:
#   R2  -> STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#          STORAGE_REGION=auto, STORAGE_FORCE_PATH_STYLE=true
#   S3  -> leave STORAGE_ENDPOINT unset, set a real STORAGE_REGION,
#          STORAGE_FORCE_PATH_STYLE=false
# The access key and secret MUST be changed in production; the app refuses to
# boot with the development values.
STORAGE_ENABLED=true
STORAGE_BUCKET=studviro
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=studviro
STORAGE_SECRET_ACCESS_KEY=studviro
STORAGE_MAX_UPLOAD_BYTES=67108864
STORAGE_SIGNED_URL_TTL_S=300
